# =====================================================================
# Coldy configuration. Copy to `.env` and fill in. All vars are prefixed
# COLDY_ except provider keys read directly by the underlying SDKs.
# =====================================================================

# --- Public base URL of THIS server (where Twilio reaches webhooks) ---
# In dev, use an ngrok/cloudflared tunnel, e.g. https://abc123.ngrok.app
COLDY_PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# --- Database ---
# Dev default is local SQLite. For production use Postgres:
#   COLDY_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/coldy
COLDY_DATABASE_URL=sqlite:///./coldy.db

# --- Anthropic (the conversational brain) ---
ANTHROPIC_API_KEY=sk-ant-...
# Turn-loop model. Phone latency favors a fast model; correctness of objection
# handling favors a smarter one. Options (fastest -> smartest):
#   claude-haiku-4-5  (lowest latency, recommended default for the turn loop)
#   claude-sonnet-4-6 (balanced)
#   claude-opus-4-8   (smartest; pair with COLDY_LLM_FAST_MODE=true)
COLDY_LLM_MODEL=claude-haiku-4-5
# Optional: use a smarter model only for hard turns (objections/pricing).
COLDY_LLM_ESCALATION_MODEL=claude-opus-4-8
# Opus 4.8 Fast Mode (2.5x output speed, premium price). Only takes effect on Opus.
COLDY_LLM_FAST_MODE=false

# --- Deepgram (speech-to-text) ---
DEEPGRAM_API_KEY=...
COLDY_STT_MODEL=nova-3

# --- Cartesia (ultra-low-latency text-to-speech) ---
CARTESIA_API_KEY=...
# A Cartesia voice id. Pick a warm, conversational US English voice.
COLDY_TTS_VOICE_ID=71a7ad14-091c-4e8e-a314-022ece01c121

# --- Twilio (telephony) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The number you place calls FROM. For "local presence" you'd rotate a pool.
COLDY_TWILIO_FROM_NUMBER=+16125550100
# Optional: a human fallback number to warm-transfer interested leads to.
COLDY_TRANSFER_NUMBER=+16125550101

# --- Brand / persona (who the AI says it is) ---
COLDY_COMPANY_NAME=Launch Media
COLDY_AGENT_NAME=Avery
COLDY_PRODUCT_NAME=Oxsome
COLDY_PRODUCT_PITCH=an AI marketing platform that builds your website, runs your SEO and Google Ads, and handles your social media from one dashboard

# --- Compliance (DO NOT disable these in production without legal review) ---
# Require prior express WRITTEN consent before any AI telemarketing call.
# The FCC (Feb 2024) treats AI voices as "artificial/prerecorded" under the
# TCPA, which requires prior express written consent for telemarketing.
COLDY_REQUIRE_WRITTEN_CONSENT=true
# Local calling window (24h clock, lead's local time). TCPA: 8am-9pm.
COLDY_CALL_WINDOW_START_HOUR=9
COLDY_CALL_WINDOW_END_HOUR=20
# Max call attempts per lead before giving up.
COLDY_MAX_ATTEMPTS=3
# Minimum hours between attempts to the same lead.
COLDY_RETRY_INTERVAL_HOURS=24
# Record calls? If true, recording-consent rules are enforced per state.
COLDY_RECORD_CALLS=false

# --- Dialer pacing ---
# Max simultaneous live calls (also bounded by your Twilio concurrency limit).
COLDY_MAX_CONCURRENT_CALLS=5
# Seconds between dial attempts (pacing / spam-label mitigation).
COLDY_DIAL_INTERVAL_SECONDS=8

# --- CRM webhook (optional): outcomes POSTed here as JSON ---
COLDY_CRM_WEBHOOK_URL=
COLDY_CRM_WEBHOOK_SECRET=

# --- Logging ---
COLDY_LOG_LEVEL=INFO
